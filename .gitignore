# raw and processed genomic data (2.4GB, not suitable for git)
data/

# model weights
checkpoints/

# large per-window result arrays (results/*.json summaries are tracked)
results/*.npz

# manuscript drafts, figures, tables, and the scripts that build them
manuscript/

# internal working notes, not for the code-availability audience
project_status.md
notes/

# SLURM submission scripts
slurm/

# hf_space demo assets: checkpoints (already excluded by checkpoints/ above),
# JASPAR panel, AD reference-embedding pool, calibration/example data -- same
# "code only, no weights/data" convention as the rest of this repo. The demo
# app's own code (app.py, src/, requirements.txt, README/DEPLOY) IS tracked;
# see hf_space/DEPLOY.md for how assets/ is rebuilt (precompute_app_assets.py)
# and deployed straight to Hugging Face, not via this repo.
hf_space/assets/
hf_space/hf_token.txt

# large source documents
*.zip
*.pdf

# python
__pycache__/
*.pyc
python_libs/

# misc
.DS_Store
*.log

# local media assets and SFTP helper notes, not for the code-availability audience
media/
SFTP_TRANSFER_GUIDE.txt
