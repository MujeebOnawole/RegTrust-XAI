# raw and processed genomic data (2.4GB, not suitable for git)
data/

# model weights
checkpoints/

# large per-window result arrays (results/*.json summaries are tracked)
results/*.npz

# manuscript drafts, figures, tables, and the scripts that build them
manuscript/

# internal working notes, not for the code-availability audience
project_status.md
notes/

# SLURM submission scripts
slurm/

# hf_space/assets/ (checkpoints, JASPAR panel, AD reference-embedding pool,
# calibration/example data) IS tracked, unlike checkpoints/ and data/ above --
# it's a small (~6MB), static, inference-only export, not the full training
# pipeline's checkpoints, and the repo is deployed directly to Render/Cloud
# Run from this same GitHub repo, so the deployed image needs it present.
# See hf_space/DEPLOY.md for how it's rebuilt (precompute_app_assets.py).
# Un-ignore it specifically, since the blanket checkpoints/ rule above would
# otherwise also catch hf_space/assets/checkpoints/.
!hf_space/assets/checkpoints/
!hf_space/assets/checkpoints/*.pt
hf_space/hf_token.txt

# large source documents
*.zip
*.pdf

# python
__pycache__/
*.pyc
python_libs/

# misc
.DS_Store
*.log

# local media assets and SFTP helper notes, not for the code-availability audience
media/
SFTP_TRANSFER_GUIDE.txt
